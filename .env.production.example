QUICK_LISTING_AI_MODEL=gpt-5.2


DEMO=0
DEMO_TTL_MINUTES=360
DEMO_USER_PASSWORD=
DEMO_MAX_CONCURRENT_INSTANCES=25
DEMO_TURNSTILE_ENABLED=0
TURNSTILE_SITE_KEY=0x4AAAAAACogGCt62w6ahqM4
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT_SECONDS=8
